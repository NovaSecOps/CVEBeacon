[Unit]
Description=Apply a requested signed CVEBeacon update
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
EnvironmentFile=-/etc/cvebeacon/update.env
ExecStart=/opt/cvebeacon/current/.venv/bin/cvebeacon --config /var/lib/cvebeacon/cvebeacon.toml update apply --from-request
TimeoutStartSec=infinity
UMask=0022
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/cvebeacon /var/lib/cvebeacon

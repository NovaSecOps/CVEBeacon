[Unit]
Description=CVEBeacon monitoring run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cvebeacon
Group=cvebeacon
WorkingDirectory=/var/lib/cvebeacon
EnvironmentFile=-/var/lib/cvebeacon/cvebeacon.env
ExecStart=/opt/cvebeacon/current/.venv/bin/cvebeacon --config /var/lib/cvebeacon/cvebeacon.toml run
TimeoutStartSec=infinity
TimeoutStopSec=infinity
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cvebeacon
PrivateTmp=yes
